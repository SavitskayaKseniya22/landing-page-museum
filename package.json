{
  "name": "museum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run lint:styles && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "@fontsource/forum": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
